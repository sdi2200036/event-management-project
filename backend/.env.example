# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=eventmanagement

# Prisma (constructed from above values)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/eventmanagement"

# JWT
JWT_SECRET=long_random_secret_string_that_you_will_never_guess_1!!11!
JWT_EXPIRES_IN=24h

# Server
PORT=3000
FRONTEND_URL=["https://localhost:4200","http://localhost:4200"]

# SSL Certificates (paths relative to backend/ directory)
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# Default path: <repo-root>/dataset/rel_event_csvs/event_interest.csv
DATASET_PATH=
